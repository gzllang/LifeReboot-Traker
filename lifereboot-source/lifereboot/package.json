{
  "name": "lifereboot",
  "productName": "LifeReboot",
  "version": "1.1.0",
  "description": "Bilingual (CN/EN) goal tracker for Windows - reboot your life in one day, every day",
  "main": "main.js",
  "author": "华赫智能",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.huahie.lifereboot",
    "productName": "LifeReboot",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "index.html",
      "icon.png"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "LifeReboot"
    }
  }
}
