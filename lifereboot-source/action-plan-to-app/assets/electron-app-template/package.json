{
  "__注释1": "复制本模板后：全局替换 <APP> 为应用标识（小写连字符），<产品名> 为中文产品名，其余不用动",
  "__注释2": "electronDist 复用本地已装的 Electron，打包时省 ~100MB 下载，勿删",
  "name": "<APP>",
  "productName": "<产品名>",
  "version": "1.0.0",
  "description": "<一句话产品描述>",
  "main": "main.js",
  "author": "<作者>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.<APP>",
    "productName": "<产品名>",
    "directories": {
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "index.html",
      "icon.png"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "<产品名>"
    }
  }
}
